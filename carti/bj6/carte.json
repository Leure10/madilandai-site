,578],[352,648],[164,648],[164,828],[37,648],[1006,648],[406,785],[536,373],[130,651],[37,828],[325,892],[232,763],[784,360],[499,797],[1006,828],[701,350],[461,381],[790,640],[741,690],[765,519],[764,492],[873,604],[494,610],[602,705],[513,576],[510,618],[256,444],[826,678],[783,339],[389,632],[49,936],[1023,454],[85,406],[1023,402],[75,273],[713,365],[929,937],[473,389],[276,713],[532,572],[494,596],[518,607]]},"55":{"c":"","n":136,"p":[[1023,576],[179,469],[599,94],[1023,891],[70,926],[893,122],[337,219],[100,154],[528,430],[631,324],[422,326],[913,417],[610,244],[719,732],[730,575],[385,671],[384,539],[300,442],[640,706],[496,694],[579,702],[598,598],[815,197],[491,493],[547,811],[554,208],[1023,60],[396,857],[483,846],[658,854],[416,570],[592,846],[468,596],[437,833],[336,625],[387,809],[425,629],[484,804],[415,253],[408,457],[686,603],[391,596],[525,591],[471,526],[651,454],[708,627],[376,463],[492,640],[366,591],[423,533],[622,516],[720,673],[669,58],[451,698],[634,887],[944,284],[58,325],[347,685],[640,199],[686,347],[624,532],[573,879],[664,811],[367,355],[944,671],[584,805],[429,483],[666,471],[676,728],[375,727],[703,586],[627,809],[770,251],[448,651],[569,588],[539,482],[514,644],[506,351],[677,498],[618,833],[684,838],[561,343],[596,204],[456,471],[535,492],[568,576],[670,348],[331,406],[508,609],[505,600],[380,367],[729,403],[900,465],[459,354],[754,213],[618,489],[818,453],[429,586],[687,541],[723,624],[463,346],[382,352],[502,591],[503,618],[568,618],[591,342],[532,262],[653,555],[676,715],[594,563],[618,588],[633,594],[595,353],[595,618],[459,306],[897,557],[498,356],[422,518],[647,623],[606,632],[52,540],[109,660],[592,378],[671,386],[604,356],[451,361],[724,495],[741,580],[645,689],[649,768],[576,676],[565,725],[598,756],[603,555],[639,606],[649,646]]}},"text":{"6":"Bodie showed Jodie his room. There was his bed, right under the window. And there on the pillow sat a little teddy bear. \u201cWho\u2019s that?\u201d asked Jodie. \u201cThat\u2019s Oatmeal,\u201d Bodie said softly. \u201cOATMEAL?\u201d Jodie giggled. \u201cWaffles and Oatmeal! We have a whole breakfast!\u201d Bodie giggled too.","16":"Soon there were five fireflies in the jar. Blink, blink went the jar. \u201cThey\u2019re only visiting,\u201d said Bodie\u2019s dad. \u201cLet them go before you fall asleep, so they can get back home.\u201d Jodie hugged the jar. \u201cThen they can stay all night,\u201d she said, \u201cbecause I\u2019m not going to sleep!\u201d","32":"Bodie took his sketchbook. Scritch-scratch went his crayon, in the little light of the jar. He drew a small round cloud, with a tuft on top and a tiny smile. Then the page moved. It puffed up, soft as a pillow. Fuff. And the little cloud floated right off the paper!","42":"At the end of the street, two round eyes looked out from Mrs. Hazel\u2019s fence. It was Moonbeam, her fluffy cat. \u201cFinally!\u201d called Jodie. \u201cSomebody who isn\u2019t sleepy!\u201d Moonbeam stretched one paw. She stretched the other paw. Then she curled up in a ball and shut her eyes.","54":"And there it was. The moon! It was much bigger than it looked from the window, and it glowed like a night-light. Tuft shrank down, and they climbed on and sat side by side, with their feet hanging. Back and forth, back and forth, it rocked. \u201cA swing,\u201d said Bodie."}}